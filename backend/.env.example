# ── Server ──────────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# Local:
MONGO_URI=mongodb://localhost:27017
# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=pulsep

# ── Redis ────────────────────────────────────────────────────────────────────
# Local:
REDIS_ADDR=localhost:6379
REDIS_PASS=
# Upstash / Redis Cloud example:
# REDIS_ADDR=your-endpoint.upstash.io:6380
# REDIS_PASS=your-redis-password

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_secret_string_at_least_32_chars
